  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Native filled form action, represented at a 54dp minimum height. Browser feedback is a panel affordance.",
      "html": "<button class=\"ds-btn-primary\">Create playlist</button>",
      "css": ".ds-btn-primary{font-family:Roboto,Arial,sans-serif;min-height:54px;border:0;border-radius:999px;padding:0 24px;background:#1ED76A;color:#00210D;font-size:14px;font-weight:700}.ds-btn-primary:disabled{opacity:.38}.ds-btn-primary:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{filter:brightness(.92)}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "See all, Retry, and native secondary dialog actions.",
      "html": "<button class=\"ds-btn-text\">See all →</button>",
      "css": ".ds-btn-text{font-family:Roboto,Arial,sans-serif;min-height:48px;padding:0 10px;border:0;border-radius:999px;background:transparent;color:#1ED76A;font-size:14px;font-weight:700}.ds-btn-text:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-btn-text:hover{filter:brightness(1.08)}.ds-btn-text:active{filter:brightness(.92)}"
    },
    {
      "name": "Play button",
      "kind": "button",
      "refersTo": "button-play",
      "description": "Fixed green circular playback action; full player uses the larger 74dp variant.",
      "html": "<button class=\"ds-btn-play\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"32\" height=\"32\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M8 5v14l11-7z\"/></svg></button>",
      "css": ".ds-btn-play{font-family:Roboto,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;border:0;border-radius:50%;background:#1ED76A;color:#00210D}.ds-btn-play:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-btn-play:hover{filter:brightness(1.08)}.ds-btn-play:active{filter:brightness(.92)}"
    },
    {
      "name": "Outlined search field",
      "kind": "input",
      "refersTo": "field-outlined",
      "description": "Search field with 14dp corners and native role colors. The label preserves context in the preview.",
      "html": "<label class=\"ds-search\"><span class=\"ds-search-label\">Search music</span><span class=\"ds-search-box\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"m15 15 6 6\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><input class=\"ds-search-input\" placeholder=\"Songs, artists, albums…\"/></span></label>",
      "css": ".ds-search{font-family:Roboto,Arial,sans-serif;display:block;width:320px;max-width:100%;color:#B8C8BE}.ds-search-label{display:block;font-size:12px;margin-bottom:6px}.ds-search-box{display:flex;align-items:center;gap:12px;border:1px solid #728A7C;border-radius:14px;padding:12px 16px;min-height:24px;background:#091F16}.ds-search-input{font-family:Roboto,Arial,sans-serif;width:100%;min-width:0;background:transparent;border:0;color:#F5FAF6;font-size:16px;outline:0}.ds-search-input::placeholder{color:#B8C8BE}.ds-search-box:hover{border-color:#F5FAF6}.ds-search-box:focus-within{border-color:#1ED76A;outline:1px solid #1ED76A}"
    },
    {
      "name": "Selected filter chip",
      "kind": "chip",
      "refersTo": "filter-selected",
      "description": "Selected discovery/category filter; native minimum height is 48dp.",
      "html": "<button class=\"ds-chip-selected\" aria-pressed=\"true\">All</button>",
      "css": ".ds-chip-selected{font-family:Roboto,Arial,sans-serif;min-height:48px;border:0;border-radius:999px;padding:0 24px;background:#1ED76A;color:#00210D;font-size:14px;font-weight:700}.ds-chip-selected:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-chip-selected:hover{filter:brightness(1.08)}.ds-chip-selected:active{filter:brightness(.92)}"
    },
    {
      "name": "Unselected filter chip",
      "kind": "chip",
      "refersTo": "filter-unselected",
      "description": "Outlined filter awaiting selection.",
      "html": "<button class=\"ds-chip-unselected\" aria-pressed=\"false\">Music</button>",
      "css": ".ds-chip-unselected{font-family:Roboto,Arial,sans-serif;min-height:48px;border:1px solid #728A7C;border-radius:999px;padding:0 24px;background:#00160D;color:#B8C8BE;font-size:14px;font-weight:700}.ds-chip-unselected:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-chip-unselected:hover{filter:brightness(1.08)}.ds-chip-unselected:active{filter:brightness(.92)}"
    },
    {
      "name": "Artwork shelf item",
      "kind": "card",
      "refersTo": "artwork-card",
      "description": "148dp artwork square with a separate un-clipped caption. Uses the implemented music-note image fallback in this panel specimen.",
      "html": "<button class=\"ds-art-card\"><span class=\"ds-art-image\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 3v10.6a4 4 0 1 0 2 3.4V7h6V3z\"/></svg></span><span class=\"ds-art-title\">Track title</span><span class=\"ds-art-artist\">Artist name</span></button>",
      "css": ".ds-art-card{font-family:Roboto,Arial,sans-serif;display:block;width:148px;background:transparent;border:0;padding:0;text-align:left;color:#F5FAF6}.ds-art-image{display:flex;align-items:center;justify-content:center;width:148px;height:148px;overflow:hidden;border-radius:14px;background:#20352A;color:#B8C8BE}.ds-art-title{display:block;margin-top:9px;font-size:14px;font-weight:600;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-art-artist{display:block;margin-top:3px;font-size:12px;line-height:18px;color:#B8C8BE}.ds-art-card:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-art-card:hover{filter:brightness(1.08)}.ds-art-card:active{filter:brightness(.92)}"
    },
    {
      "name": "Active track row",
      "kind": "custom",
      "refersTo": "song-row-active",
      "description": "Current track stays green when paused; the playing bars are a static state indicator. Artwork uses the native fallback here.",
      "html": "<button class=\"ds-track\"><span class=\"ds-track-art\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 3v10.6a4 4 0 1 0 2 3.4V7h6V3z\"/></svg></span><span class=\"ds-track-copy\"><span class=\"ds-track-title\">Current track</span><span class=\"ds-track-artist\">Artist name</span></span><span class=\"ds-track-bars\" aria-label=\"Playing\"><i></i><i></i><i></i><i></i></span></button>",
      "css": ".ds-track{font-family:Roboto,Arial,sans-serif;display:flex;align-items:center;width:360px;max-width:100%;padding:9px 10px;border:0;border-radius:16px;background:#1ED76A;color:#00210D;text-align:left}.ds-track-art{display:flex;align-items:center;justify-content:center;width:54px;height:54px;flex-shrink:0;border-radius:14px;background:#20352A;color:#B8C8BE}.ds-track-copy{flex:1;min-width:0;margin:0 12px}.ds-track-title{display:block;font-size:16px;font-weight:600;line-height:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-track-artist{display:block;margin-top:3px;font-size:14px;line-height:21px}.ds-track-bars{display:flex;align-items:center;gap:3px;width:22px;height:24px}.ds-track-bars i{width:3px;height:10px;border-radius:999px;background:currentColor}.ds-track-bars i:nth-child(2){height:22px}.ds-track-bars i:nth-child(3){height:15px}.ds-track-bars i:nth-child(4){height:8px}.ds-track:focus-visible{outline:2px solid #1ED76A;outline-offset:3px}.ds-track:hover{filter:brightness(1.08)}.ds-track:active{filter:brightness(.92)}"
    },
    {
      "name": "Compact navigation",
      "kind": "nav",
      "refersTo": "navigation-compact",
      "description": "Four persistent destinations below the mini-player on compact screens. The rail replaces this at 700dp.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><button class=\"ds-nav-item ds-nav-selected\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"m12 3 10 9h-3v9h-5v-6h-4v6H5v-9H2z\"/></svg><span>Home</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"m15 15 6 6\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>Search</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M3 3v18h18M7 3v14h14V3zM12 6h6v5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>Your library</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>Create</span></button></nav>",
      "css": ".ds-nav{font-family:Roboto,Arial,sans-serif;display:flex;align-items:center;min-height:72px;width:380px;max-width:100%;background:#00160D}.ds-nav-item{font-family:Roboto,Arial,sans-serif;display:flex;flex:1;align-items:center;flex-direction:column;gap:4px;min-height:64px;padding:6px 2px;border:0;border-radius:16px;background:transparent;color:#B8C8BE;font-size:12px;font-weight:500}.ds-nav-selected{color:#F5FAF6}.ds-nav-selected svg{background:#0C2C1B;border-radius:999px;padding:4px 16px}.ds-nav-item:hover{background:#091F16}.ds-nav-item:focus-visible{outline:2px solid #1ED76A;outline-offset:-2px}.ds-nav-item:active{filter:brightness(.9)}"
    },
    {
      "name": "Mini-player",
      "kind": "custom",
      "refersTo": "mini-player",
      "description": "Secondary-container playback strip with 48dp artwork and a 2dp progress line. Buttons illustrate the native controls.",
      "html": "<div class=\"ds-mini\"><div class=\"ds-mini-row\"><button class=\"ds-mini-open\" aria-label=\"Open player\"><span class=\"ds-mini-art\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 3v10.6a4 4 0 1 0 2 3.4V7h6V3z\"/></svg></span><span class=\"ds-mini-copy\"><strong class=\"ds-mini-title\">Current track</strong><span class=\"ds-mini-artist\">Artist name</span></span></button><button class=\"ds-mini-control\" aria-label=\"Like song\">♡</button><button class=\"ds-mini-control\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"32\" height=\"32\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M8 5v14l11-7z\"/></svg></button></div><div class=\"ds-mini-progress\"><span></span></div></div>",
      "css": ".ds-mini{font-family:Roboto,Arial,sans-serif;width:380px;max-width:100%;border:1px solid #344D3F;border-radius:16px;background:#2A3D32;color:#F5FAF6;overflow:hidden}.ds-mini-row{display:flex;align-items:center;padding:7px 6px 5px 8px}.ds-mini-open{font-family:Roboto,Arial,sans-serif;display:flex;align-items:center;flex:1;min-width:0;padding:0;border:0;background:transparent;color:inherit;text-align:left}.ds-mini-art{display:flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0;border-radius:14px;background:#20352A;color:#B8C8BE}.ds-mini-copy{min-width:0;margin:0 12px}.ds-mini-title{display:block;font-size:14px;font-weight:600;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-mini-artist{display:block;color:#B8C8BE;font-size:12px;line-height:18px}.ds-mini-control{display:flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0;border:0;border-radius:50%;background:transparent;color:#F5FAF6;font-size:28px}.ds-mini-progress{height:2px;margin:0 12px;background:#344D3F}.ds-mini-progress span{display:block;width:40%;height:2px;background:#1ED76A}.ds-mini-open:hover,.ds-mini-control:hover{filter:brightness(1.15)}.ds-mini-open:focus-visible,.ds-mini-control:focus-visible{outline:2px solid #1ED76A;outline-offset:-2px}.ds-mini-control:active{background:#20352A}"
    }
  ],
  "narrative": {
    "northStar": "The supplied forest-green music reference",
    "overview": "Sortify uses the user's pinned forest-green music reference and supplied green S mark. Near-black green surfaces, clear white type, bright playback controls, square artwork, and circular artists carry that reference across a native Kotlin and Jetpack Compose app. This is an Operate surface: discovery stays image-led while controls and labels remain familiar Android controls.\n\nThe light appearance preserves the same role relationships through pale green surfaces, dark text, and a deeper green primary. The interface is compact enough for browsing a music collection, with larger welcome and section headings creating hierarchy. The product needs no account; the visual system supports a local personal library without implying a connected sign-in service.",
    "keyCharacteristics": [
      "Forest-green tonal surfaces with vivid green playback and active-track states.",
      "Artwork-led browsing with captions outside artwork clipping.",
      "Roboto/system Sans with bold headings and quiet supporting text.",
      "Persistent playback controls and native phone/tablet navigation.",
      "Dark, Light, and System appearances with the same semantic roles."
    ],
    "rules": [
      {
        "name": "The Role Pairing Rule",
        "body": "Use each theme's foreground with its matching container. Playback green and active-track green keep the deep-green foreground in both appearances.",
        "section": "colors"
      },
      {
        "name": "The Caption Boundary Rule",
        "body": "Clip artwork and collages to their image shape; never apply the artwork clip to the Column that also contains captions.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use the existing green surface roles, restrained borders, and artwork scrims for hierarchy. Leave modal depth and interaction feedback to native Material 3.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the supplied Sortify S mark and the theme's green primary for the brand.",
      "Do use dp for dimensions and sp for text, with Roboto/system Sans and the extracted type roles.",
      "Do preserve at least 48dp targets for shared icon actions and filter chips.",
      "Do keep the mini-player above compact navigation whenever a current track exists.",
      "Do let captions and supporting text measure to their content height, including at increased font scale.",
      "Do show loading, retry, no-results, empty-library, selected, playing, paused, and downloaded states using the shared patterns.",
      "Do use the rail at 700dp and above, with the main content constrained to 900dp."
    ],
    "donts": [
      "Don't replace the supplied forest-green visual direction or green Sortify identity with a new palette or mark.",
      "Don't clip caption Columns to artwork corners or a fixed artwork height.",
      "Don't use the bright playback green with white text; preserve its deep-green foreground.",
      "Don't stretch the player cover beyond its responsive size cap or place compact navigation on the full player and queue screens.",
      "Don't add a sign-in presentation that implies an account service exists."
    ]
  }
}

